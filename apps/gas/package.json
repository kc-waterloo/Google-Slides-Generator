{
  "name": "@gsg/gas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "setup": "tsc -p ./util && node ./util/build/setup.js",
    "build": "npm run lint:fix && npm run setup && npm run build-no-lint",
    "build-no-lint": "rollup -c",
    "push-no-build": "clasp push",
    "push": "npm run build && npm run push-no-build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@gsg/shared": "*",
    "@rollup/plugin-node-resolve": "^16.0.3"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "12.3.0",
    "@types/google-apps-script": "^2.0.11",
    "@types/jest": "^30.0.0",
    "eslint-plugin-comment-header": "https://github.com/leeminkyu16/ESLint-Plugin-Comment-Header/releases/download/v0.0.1/eslint-plugin-comment-header-0.0.1.tgz",
    "jest": "^30.4.2",
    "rollup": "^4.9.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.0"
  }
}
